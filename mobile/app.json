{
  "expo": {
    "name": "HDS Chat",
    "slug": "hds-chat-android",
    "owner": "sifosman",
    "version": "2.0.5",
    "scheme": "hds-chat",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "za.co.hdsgroup.chat",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chat.hdsgroup.co.za",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/withAssetStatements",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ee1c25"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-audio",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 96,
          "backgroundColor": "#000000"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "nativePushEnabled": true,
      "eas": {
        "projectId": "18114d09-7139-421f-93b7-817c8f45678b"
      }
    }
  }
}
